          "parent_relay",
          "child_a_shell",
          "child_a_endpoint",
          "child_a_ring",
          "child_a_ready",
          "child_b_shell",
          "child_b_endpoint",
          "child_b_ring",
          "child_b_ready"
        ],
        "note": "从 Parent 会合开始，观察两个 color 组如何各自形成独立 Child communicator。"
      },
      {
        "id": "parent_build",
        "label": "Parent 建链",
        "focus": ["parent_rendezvous", "parent_ready"],
        "note": "Root 只收集 endpoint 并返回 nextPeer；每个 rank 随后建立自己的 Parent bootstrapState。"
      },
      {
        "id": "split_relay",
        "label": "Split 借道",
        "focus": [
          "split_membership",
          "child_a_shell",
          "child_a_endpoint",
          "child_b_shell",
          "child_b_endpoint",
          "parent_relay",
          "child_a_ring",
          "child_b_ring"
        ],
        "note": "先用 Parent AllGather 算成员表，再借 Parent P2P socket 交换 Child endpoint。"
      },
      {
        "id": "state_ownership",
        "label": "状态与所有权",
        "focus": [
          "parent_ready",
          "child_a_shell",
          "child_a_ring",
          "child_a_ready",
          "child_b_shell",
          "child_b_ring",
          "child_b_ready"
        ],
        "note": "三个 comm 各自拥有 bootstrapState；splitShare 只改变部分资源复用，不合并 bootstrap ring。"
      }
    ],
    "output": "doc/archify/nccl-bootstrap-multi-comm.html",
